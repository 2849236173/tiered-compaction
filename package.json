{
  "name": "dsh-tiered-compaction",
  "description": "DSH 分层上下文压缩插件：无损折叠 → 落盘 → 软压力 → 有损摘要四层管线，前三层零 LLM 成本。装完即生效。",
  "version": "0.4.0-beta.2",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "test/",
    "client/",
    "tools/check-install.mjs",
    "tools/lib/",
    "docs/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "context-compaction",
    "context-management",
    "token-optimization",
    "llm"
  ],
  "license": "MIT",
  "author": "xiaoyaoke1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2849236173/tiered-compaction.git"
  },
  "bugs": {
    "url": "https://github.com/2849236173/tiered-compaction/issues"
  },
  "homepage": "https://github.com/2849236173/tiered-compaction#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:install": "node tools/check-install.mjs",
    "postinstall": "node -e \"const fs=require('fs');const ok=fs.existsSync('src/single-writer-guard.js')&&fs.existsSync('test/d24-single-writer.test.js');console.log(ok?'dsh-tiered-compaction: single-writer guard & tripwire present':'WARN: guard files missing—double-mount protection incomplete')\"",
    "check": "node --check src/index.js && node -e \"import('./src/index.js').then(()=>console.log('入口可加载 OK')).catch(e=>{console.error(e);process.exit(1)})\"",
    "build": "npm run check && npm test"
  }
}

